{
  "name": "@spring-mox/vite-plugin-react",
  "description": "Vite plugin that generates type-safe routes from Spring WebMvc metadata (routes.json) using @spring-mox/base",
  "version": "0.1.0",
  "module": "src/index.ts",
  "license": "MIT",
  "keywords": ["bun", "vite", "vite-plugin", "spring-boot", "spring"],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@spring-mox/base": "0.3.0",
    "vite": "^8.1.5"
  }
}
